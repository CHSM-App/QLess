# Copy to key.properties and fill in real values. NEVER commit key.properties
# or the .jks file to git — both are listed in .gitignore.
#
# Generate the keystore once with:
#
#   keytool -genkey -v -keystore android/keystore/qless-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 \
#           -alias qless-release
#
# Then drop the answers (passwords + alias) into the four fields below.

storeFile=keystore/qless-release.jks
storePassword=replace-with-keystore-password
keyAlias=qless-release
keyPassword=replace-with-key-password
