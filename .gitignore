#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
/build/
**/build/
/coverage/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing — NEVER commit these. Loss of the keystore means
# you can never push an update to the same Play listing. Back it up
# offline (USB / password manager / 1Password vault).
**/key.properties
**/*.jks
**/*.keystore
**/keystore/
.claude/
