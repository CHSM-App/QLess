# Normalize line endings across platforms.
# Store text files as LF in the repo and check them out as LF everywhere.
# This stops the Windows "LF will be replaced by CRLF" warnings and the
# CRLF/LF churn it causes for Flutter/Dart source and generated files.
* text=auto eol=lf

# Windows-only scripts that genuinely need CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets: never apply line-ending conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   binary
*.otf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.so    binary
*.dll   binary
*.dylib binary
*.a     binary
*.jar   binary
*.keystore binary
*.jks   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.7z    binary
*.pdf   binary
