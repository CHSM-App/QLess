<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough"/>
    <webSocket enabled="true" />

    <httpProtocol>
      <customHeaders>
        <add name="Connection" value="keep-alive"/>
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <verbs>
          <add verb="OPTIONS" allowed="true"/>
        </verbs>
      </requestFiltering>
    </security>

    <tracing>
      <traceFailedRequests>
        <clear/>
      </traceFailedRequests>
    </tracing>

    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode"/>
    </handlers>

    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/server\.js\/debug[\/]?"/>
        </rule>
        <rule name="OPTIONS preflight" stopProcessing="true">
          <match url="(.*)"/>
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$"/>
          </conditions>
          <action type="Rewrite" url="src/server.js"/>
        </rule>
        <rule name="Node.js" stopProcessing="true">
          <match url="(.*)"/>
          <action type="Rewrite" url="src/server.js"/>
        </rule>
      </rules>
    </rewrite>

    <!--
      nodeProcessCountPerApplication="1" on purpose: socket.io rooms, doctor
      online status and the cron jobs live in this one process's memory. A second
      process would split the sockets and run every cron twice. Scale up, not out
      (DEPLOY.md section 5).
      watchedFiles: a change to a listed file restarts the app after a Git pull,
      so every folder that holds server code must be listed. Paths are relative
      to the folder of the handler script (src\), not the site root: a missing
      parent folder makes iisnode fail with 500.1000 / 0x3.
    -->
    <!--
      enableXFF: iisnode appends the real client IP to X-Forwarded-For, which
      is the entry `trust proxy 1` (server.js) reads. Without it a client could
      send its own X-Forwarded-For and dodge every per-IP rate limit. If a CDN
      (Cloudflare etc.) is ever put in front, raise `trust proxy` to match.
    -->
    <iisnode
      enableXFF="true"
      devErrorsEnabled="false"
      debuggingEnabled="false"
      loggingEnabled="true"
      logDirectory="iisnode_logs"
      maxLogFileSizeInKB="10240"
      maxTotalLogFileSizeInKB="102400"
      maxLogFiles="20"
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="200"
      namedPipeConnectionRetryDelay="250"
      maxNamedPipeConnectionPoolSize="512"
      maxNamedPipePooledConnectionAge="60000"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="*.js;routes\*.js;routes\auth\*.js;routes\doctor\*.js;routes\doctor\insert\*.js;routes\patient\*.js;queries\*.js;middleware\*.js"
      recycleSignalEnabled="false"
    />

    <directoryBrowse enabled="false"/>
  </system.webServer>

  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\vengurlatech.com\tmp"/>
  </system.web>
</configuration>
