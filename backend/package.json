{
  "name": "donotwait",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "migrate": "node src/migrate.js",
    "migrate:up": "node src/migrate.js up",
    "migrate:down": "node src/migrate.js down",
    "migrate:status": "node src/migrate.js status",
    "db": "node scripts/run-sql.js",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint . --quiet",
    "lint:all": "eslint ."
  },
  "dependencies": {
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.2.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.8.0",
    "fs-extra": "^11.2.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "mssql": "^11.0.2",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.4"
  },
  "main": "src/server.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 15000,
    "setupFiles": [
      "./tests/setup.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/migrate.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 59,
        "branches": 48,
        "functions": 53,
        "lines": 61
      }
    }
  }
}
