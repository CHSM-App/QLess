# Copy to .env and fill in real values. NEVER commit .env to git.
# Rotate any value that has ever been pushed to a remote.

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (MSSQL) ─────────────────────────────────────────────────
DB_USER=
DB_PASSWORD=
DB_NAME=QLess_test_db
DB_SERVER=
DB_PORT=1433
DB_POOL_MAX=20
DB_POOL_MIN=0

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL=15m
# How long a user stays signed in without re-entering OTP (days). Default 30.
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Native mobile clients (no Origin header) are always allowed.
CORS_ORIGINS=https://qless.vengurlatech.com

# ── Firebase Admin SDK ───────────────────────────────────────────────
# Absolute or relative path to the service-account JSON. Preferred over
# placing a JSON file at routes/serviceAccountKey.json.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json

# ── Public base URL (used in returned image URLs) ────────────────────
PUBLIC_BASE_URL=https://qless.vengurlatech.com

# ── Admin panel (/admin) ─────────────────────────────────────────────
# Single shared staff credential for approving newly registered doctors.
# No admin table — this IS the account. Pick a strong, unique password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# WhatsApp to patients (prescription / follow-up), via SMSala approved templates.
# Uses WHATSAPP_API_TOKEN (same as OTP). Unset = the send buttons answer an error.
WHATSAPP_TEMPLATE_URL=
WHATSAPP_RX_TEMPLATE_ID=
WHATSAPP_FOLLOWUP_TEMPLATE_ID=

# AI medical report summaries (/reports, Claude Haiku). Unset key = feature answers 503.
# AI_REPORTS_ENABLED=false is the kill switch (stops all Claude spend instantly) — see ROLLBACK_AI_REPORTS.md.
ANTHROPIC_API_KEY=
AI_REPORTS_ENABLED=true
